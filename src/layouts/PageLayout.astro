---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  heroTitle: string;
  heroSubtitle?: string;
  heroEyebrow?: string;
  faqs?: Array<{ question: string; answer: string }>;
}

const {
  title,
  description,
  heroTitle,
  heroSubtitle,
  heroEyebrow = "ZeroBlue Technology Solutions",
  faqs,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead title={title} description={description} faqs={faqs} />
  </head>

  <body class="site-body">
    <Header />
    <section class="hero-panel">
      <div class="hero-grid">
        <div>
          <div class="eyebrow">
            <span class="h-2 w-2 rounded-full bg-teal-400"></span>
            {heroEyebrow}
          </div>
          <h1 class="hero-title">{heroTitle}</h1>
          {heroSubtitle && <p class="hero-subtitle">{heroSubtitle}</p>}
        </div>
        <div class="hidden lg:block">
          <slot name="heroVisual">
            <div class="surface-card p-5">
              <div class="color-strip mb-5"></div>
              <div class="grid grid-cols-3 gap-3">
                <div class="rounded-xl bg-sky-100 p-5 dark:bg-sky-500/15"></div>
                <div class="rounded-xl bg-teal-100 p-5 dark:bg-teal-500/15">
                </div>
                <div class="rounded-xl bg-amber-100 p-5 dark:bg-amber-500/15">
                </div>
              </div>
              <div class="mt-5 space-y-3">
                <div
                  class="h-3 w-3/4 rounded-full bg-slate-200 dark:bg-slate-700"
                >
                </div>
                <div
                  class="h-3 w-full rounded-full bg-slate-200 dark:bg-slate-700"
                >
                </div>
                <div
                  class="h-3 w-2/3 rounded-full bg-slate-200 dark:bg-slate-700"
                >
                </div>
              </div>
            </div>
          </slot>
        </div>
      </div>
    </section>

    <main class="site-main">
      <slot />
    </main>

    <Footer />
  </body>
</html>
