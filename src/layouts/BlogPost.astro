---
import BaseHead from "../components/BaseHead.astro"
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import PostFooter from "../components/PostFooter.astro"

const {
	frontmatter: { title, description, date, updatedDate, heroImage },
} = Astro.props
const formattedDate = date && new Date(date).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })
---

<html lang="en" class="scroll-smooth">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body class="site-body">
		<Header />

			<main class="max-w-4xl mx-auto px-4 py-12 sm:px-6">
				<article class="surface-card overflow-hidden">
					{heroImage && (
						<img
							class="w-full h-auto object-cover max-h-96"
							src={heroImage}
							alt={title}
						/>
					)}
					<div class="color-strip"></div>
					<div class="p-8 md:p-12">
						<h1 class="text-4xl md:text-5xl font-bold mb-6 text-slate-950 dark:text-white tracking-tight">{title}</h1>
						<div class="flex flex-wrap gap-4 text-sm text-slate-500 dark:text-slate-400 mb-8">
							{formattedDate && (
								<time class="flex items-center gap-2">
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
									</svg>
									{formattedDate}
								</time>
							)}
							{updatedDate && (
								<div class="flex items-center gap-2">
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
									</svg>
									Updated {updatedDate}
								</div>
							)}
						</div>
						<hr class="border-slate-200 dark:border-slate-700 mb-8"/>
						<div class="prose prose-lg dark:prose-invert max-w-none prose-headings:text-slate-950 dark:prose-headings:text-white prose-a:text-sky-600 hover:prose-a:text-teal-600 dark:prose-a:text-sky-300 dark:hover:prose-a:text-teal-200 prose-code:text-sky-600 dark:prose-code:text-sky-300">
							<slot />
						</div>
					</div>
				</article>
				<PostFooter {...Astro.props.frontmatter} />
			</main>
		<Footer />
	</body>
</html>
