---
import PageLayout from '../layouts/PageLayout.astro';

const consultationUrl = 'https://calendly.com/agnesriley';

const priorities = [
	{
		title: 'Understand the system',
		body: 'Review schema, scripts, layouts, security, integrations, and server dependencies so the next decision is based on evidence.',
	},
	{
		title: 'Fix what people trip over',
		body: 'Improve brittle workflows, risky scripts, confusing layouts, and architectural decisions that slow the team down.',
	},
	{
		title: 'Add AI only where it belongs',
		body: 'Connect FileMaker to AI-assisted search, summaries, automation, analysis, and controlled data access where it creates real value.',
	},
	{
		title: 'Check the server foundation',
		body: 'Review FileMaker Server configuration, SSL, schedules, backups, logs, performance, and operational reliability.',
	},
];

const consultingAreas = [
	{
		title: 'System & App Audits',
		points: [
			'Schema and relationship review',
			'Script, layout, and workflow analysis',
			'Security, privilege set, and account review',
			'Prioritized recommendations',
		],
	},
	{
		title: 'AI Integration',
		points: [
			'AI-assisted search and summaries',
			'Workflow automation and analysis',
			'FileMaker data access patterns',
			'Practical rollout planning',
		],
	},
	{
		title: 'Server Setup & Optimization',
		points: [
			'FileMaker Server setup review',
			'Backup and schedule validation',
			'SSL, logs, and reliability checks',
			'Performance and capacity review',
		],
	},
	{
		title: 'Performance & Stability',
		points: [
			'Slow file diagnosis',
			'Script bottleneck review',
			'Architecture risk assessment',
			'Integration and server issue triage',
		],
	},
	{
		title: 'FMDojo Monitoring Setup',
		href: 'https://fmdojo.com',
		points: [
			'Monitoring and alert configuration',
			'Log analysis visibility',
			'Server health review workflows',
			'Faster troubleshooting signals',
		],
	},
];

const signals = [
	'The file is slow and no one knows why.',
	'The server runs, but backups, logs, or SSL have not been reviewed recently.',
	'Leadership wants AI, but the current data model may not be ready.',
	'Important scripts depend on one person knowing how everything works.',
	'The system has grown for years without an outside audit.',
];

const faqs = [
	{
		question: 'What is FileMaker consulting?',
		answer: 'FileMaker consulting is expert work on existing Claris FileMaker systems: auditing schema and scripts, improving performance and stability, setting up and hardening FileMaker Server, integrating AI workflows, and modernizing brittle or outdated architecture.',
	},
	{
		question: 'How does ZeroBlue approach FileMaker work?',
		answer: 'ZeroBlue starts every engagement with diagnosis before prescribing changes. The first step is usually an audit to understand where the system is fragile, what the real risks are, and which improvements will have the highest leverage.',
	},
	{
		question: 'How do I know if my FileMaker system needs a consultant?',
		answer: "Common signs include: the file is slow and no one knows why; the server has not been externally reviewed recently; leadership wants to add AI but the data model may not be ready; important scripts depend on one person’s knowledge; or the system has grown for years without an outside audit.",
	},
	{
		question: 'What does FileMaker AI integration involve?',
		answer: 'FileMaker AI integration connects your FileMaker data and workflows to AI-assisted search, summaries, automation, and analysis. It starts with assessing whether the current data model and scripts are ready, then designs controlled data access patterns and practical rollout steps.',
	},
	{
		question: 'Does ZeroBlue build new FileMaker databases?',
		answer: 'ZeroBlue focuses on improving existing FileMaker systems rather than building new ones from scratch. The work centers on making important production systems more stable, understandable, and ready for modernization or AI integration.',
	},
];
---

<PageLayout
	title="FileMaker Consulting & System Improvement - ZeroBlue"
	description="Expert FileMaker consulting for system audits, AI integration, server setup, performance, stability, and monitoring."
	heroTitle="FileMaker consulting for systems with history."
	heroSubtitle="If your FileMaker system is slow, fragile, confusing, or suddenly expected to support AI, start by understanding what is really there."
	heroEyebrow="FileMaker Consulting"
	faqs={faqs}
>
	<Fragment slot="heroVisual">
		<div class="surface-card overflow-hidden">
			<img
				src="/images/site/filemaker-consulting-workspace.webp"
				alt="FileMaker consulting workspace with database diagrams"
				width="1680"
				height="951"
				class="aspect-[16/11] w-full object-cover"
				loading="eager"
			/>
			<div class="grid gap-3 p-5 sm:grid-cols-3">
				<div class="rounded-xl bg-sky-100 p-4 dark:bg-sky-500/15">
					<p class="text-xs font-bold uppercase tracking-wider text-sky-700 dark:text-sky-200">Audit</p>
				</div>
				<div class="rounded-xl bg-teal-100 p-4 dark:bg-teal-500/15">
					<p class="text-xs font-bold uppercase tracking-wider text-teal-700 dark:text-teal-200">Repair</p>
				</div>
				<div class="rounded-xl bg-amber-100 p-4 dark:bg-amber-500/15">
					<p class="text-xs font-bold uppercase tracking-wider text-amber-800 dark:text-amber-200">Plan</p>
				</div>
			</div>
		</div>
	</Fragment>

	<section class="py-12 lg:py-16">
		<div class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-stretch">
			<div class="surface-card p-8 lg:p-10">
				<p class="text-sm font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-300">Development starts with understanding</p>
				<h2 class="mt-4 text-3xl font-bold text-slate-800 dark:text-white md:text-4xl">
					Do not rebuild, extend, or wire AI into a FileMaker system until you understand where it is fragile.
				</h2>
				<p class="mt-5 text-lg leading-8 text-slate-700 dark:text-slate-300">
					ZeroBlue helps teams improve existing FileMaker systems with audits, modernization planning,
					AI integration, server review, and stability work. The goal is practical improvement, not a bigger mystery.
				</p>
				<div class="mt-8 flex flex-col gap-3 sm:flex-row">
					<a href={consultationUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
						Tell me what is going on
					</a>
					<a href="#consulting-areas" class="btn-secondary">
						Review Focus Areas
					</a>
				</div>
			</div>

			<div class="surface-card p-8 lg:p-10">
				<h2 class="text-2xl font-bold text-slate-800 dark:text-white">Good reasons to call</h2>
				<ul class="mt-6 space-y-4">
					{signals.map((signal) => (
						<li class="flex gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4 text-slate-700 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-300">
							<span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-teal-500"></span>
							<span>{signal}</span>
						</li>
					))}
				</ul>
			</div>
		</div>
	</section>

	<section class="py-12 lg:py-16">
		<div class="mx-auto max-w-3xl text-center">
			<p class="text-sm font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-300">How we approach FileMaker work</p>
			<h2 class="mt-3 text-3xl font-bold text-slate-800 dark:text-white md:text-4xl">
				First understand the system. Then improve the right parts.
			</h2>
		</div>
		<div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
			{priorities.map((priority, index) => (
				<article class="surface-card surface-card-hover p-6">
					<div class="mb-5 inline-flex h-11 w-11 items-center justify-center rounded-xl bg-sky-100 text-lg font-bold text-sky-700 dark:bg-sky-500/15 dark:text-sky-200">
						{index + 1}
					</div>
					<h3 class="text-xl font-bold text-slate-800 dark:text-white">{priority.title}</h3>
					<p class="mt-4 leading-7 text-slate-700 dark:text-slate-300">{priority.body}</p>
				</article>
			))}
		</div>
	</section>

	<section id="consulting-areas" class="py-12 lg:py-16">
		<div class="grid gap-6 lg:grid-cols-2">
			{consultingAreas.map((area, index) => (
				<article class:list={[
					'surface-card surface-card-hover p-7',
					index === 4 ? 'lg:col-span-2 lg:grid lg:grid-cols-[0.7fr_1fr] lg:gap-8' : '',
				]}>
					<h2 class="text-2xl font-bold text-slate-800 dark:text-white">
						{area.href ? (
							<a href={area.href} target="_blank" rel="noopener noreferrer" class="accent-link">
								{area.title}
							</a>
						) : (
							area.title
						)}
					</h2>
					<ul class="mt-6 grid gap-3 sm:grid-cols-2">
						{area.points.map((point) => (
							<li class="flex gap-3 text-slate-700 dark:text-slate-300">
								<span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-teal-500"></span>
								<span>{point}</span>
							</li>
						))}
					</ul>
				</article>
			))}
		</div>
	</section>

	<section class="py-12 lg:py-16">
		<div class="surface-card overflow-hidden">
			<div class="color-strip"></div>
			<div class="grid gap-8 p-8 lg:grid-cols-[0.85fr_1.15fr] lg:p-10">
				<div>
					<p class="text-sm font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-300">What you get</p>
					<h2 class="mt-3 text-3xl font-bold text-slate-800 dark:text-white">Clear findings, practical next steps, and hands-on help when you need it.</h2>
				</div>
				<div class="space-y-4 text-lg leading-8 text-slate-700 dark:text-slate-300">
					<p>
						A FileMaker engagement can start with a focused audit, a server review, an AI feasibility discussion,
						or a specific performance issue. From there, ZeroBlue helps prioritize the work that reduces risk and improves the system.
					</p>
					<p>
						This page is not about generic app building. It is about making important FileMaker systems more understandable,
						more stable, and better prepared for the next phase.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="py-12 lg:py-16">
		<div class="mx-auto max-w-3xl">
			<h2 class="text-3xl font-bold text-slate-800 dark:text-white md:text-4xl">Frequently Asked Questions</h2>
			<dl class="mt-8 space-y-4">
				{faqs.map((faq) => (
					<div class="surface-card p-6">
						<dt class="text-lg font-semibold text-slate-800 dark:text-white">{faq.question}</dt>
						<dd class="mt-3 leading-7 text-slate-700 dark:text-slate-300">{faq.answer}</dd>
					</div>
				))}
			</dl>
		</div>
	</section>

	<section class="rounded-2xl bg-slate-800 p-8 text-white shadow-xl shadow-slate-900/20 dark:bg-sky-900 lg:p-12">
		<div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
			<div>
				<p class="text-sm font-semibold uppercase tracking-wider text-teal-300">Need FileMaker help?</p>
				<h2 class="mt-3 text-3xl font-bold md:text-4xl">Start with what is happening now.</h2>
				<p class="mt-4 max-w-3xl text-lg leading-8 text-slate-300">
					Bring the system history, the symptoms, or the improvement goal. We will help determine whether the right next step
					is an audit, AI integration plan, server review, monitoring setup, or targeted stability work.
				</p>
			</div>
			<a href={consultationUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
				Tell me what is going on
			</a>
		</div>
	</section>
</PageLayout>
