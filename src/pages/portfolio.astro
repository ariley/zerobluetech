---
import PageLayout from '../layouts/PageLayout.astro';
import CTA from '../components/CTA.astro';
---

<PageLayout
	title="Portfolio - ZeroBlue"
	description="View our portfolio of successful FileMaker and web development projects"
	heroTitle="Our Portfolio"
	heroSubtitle="Explore our successful projects and see how we've helped businesses transform their operations."
>

			<!-- Portfolio Categories -->
			<section class="py-16">
				<div class="grid md:grid-cols-3 gap-6">
					<!-- FileMaker Solutions -->
					<div class="group p-8 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 shadow-lg shadow-zinc-600/5 transition-all duration-300 hover:-translate-y-2 hover:shadow-xl hover:shadow-sky-500/10 hover:border-sky-500/50">
						<h2 class="text-2xl font-bold mb-4 text-zinc-800 dark:text-zinc-200">FileMaker Solutions</h2>
						<p class="text-zinc-600 dark:text-zinc-400 mb-6 leading-relaxed">
							Custom database solutions for businesses across various industries including healthcare, education, and manufacturing.
						</p>
						<ul class="space-y-2 text-zinc-600 dark:text-zinc-400">
							<li>• Inventory Management Systems</li>
							<li>• CRM Solutions</li>
							<li>• Project Management Tools</li>
							<li>• Document Management</li>
						</ul>
					</div>

					<!-- Web Development -->
					<div class="group p-8 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 shadow-lg shadow-zinc-600/5 transition-all duration-300 hover:-translate-y-2 hover:shadow-xl hover:shadow-sky-500/10 hover:border-sky-500/50">
						<h2 class="text-2xl font-bold mb-4 text-zinc-800 dark:text-zinc-200">Web Development</h2>
						<p class="text-zinc-600 dark:text-zinc-400 mb-6 leading-relaxed">
							Modern, responsive websites and web applications built with the latest technologies.
						</p>
						<ul class="space-y-2 text-zinc-600 dark:text-zinc-400">
							<li>• Corporate Websites</li>
							<li>• E-Commerce Platforms</li>
							<li>• Custom Web Applications</li>
							<li>• WordPress Sites</li>
						</ul>
					</div>

					<!-- Mobile Solutions -->
					<div class="group p-8 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 shadow-lg shadow-zinc-600/5 transition-all duration-300 hover:-translate-y-2 hover:shadow-xl hover:shadow-sky-500/10 hover:border-sky-500/50">
						<h2 class="text-2xl font-bold mb-4 text-zinc-800 dark:text-zinc-200">Mobile Solutions</h2>
						<p class="text-zinc-600 dark:text-zinc-400 mb-6 leading-relaxed">
							FileMaker Go solutions and mobile-optimized applications for on-the-go data access.
						</p>
						<ul class="space-y-2 text-zinc-600 dark:text-zinc-400">
							<li>• Field Service Apps</li>
							<li>• Mobile Data Collection</li>
							<li>• Barcode Scanning</li>
							<li>• Calendar Integration</li>
						</ul>
					</div>
				</div>
			</section>

			<!-- Success Stories -->
			<section class="py-16">
				<h2 class="text-4xl font-bold mb-12 text-zinc-800 dark:text-zinc-200 tracking-tight text-center">Success Stories</h2>
				<div class="space-y-6">
					<!-- Story 1 -->
					<div class="group p-8 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 shadow-lg shadow-zinc-600/5 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-sky-500/10 hover:border-sky-500/50">
						<h3 class="text-2xl font-semibold mb-3 text-sky-500">Healthcare Practice Management</h3>
						<p class="text-zinc-600 dark:text-zinc-400 mb-4 leading-relaxed">
							Developed a comprehensive practice management system for a multi-location healthcare provider,
							streamlining patient records, scheduling, and billing processes.
						</p>
						<div class="flex flex-wrap gap-2">
							<span class="bg-sky-500/10 text-sky-600 dark:text-sky-400 px-3 py-1 rounded-full text-sm font-medium">FileMaker</span>
							<span class="bg-sky-500/10 text-sky-600 dark:text-sky-400 px-3 py-1 rounded-full text-sm font-medium">Mobile Access</span>
							<span class="bg-sky-500/10 text-sky-600 dark:text-sky-400 px-3 py-1 rounded-full text-sm font-medium">Integration</span>
						</div>
					</div>

					<!-- Story 2 -->
					<div class="group p-8 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 shadow-lg shadow-zinc-600/5 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-sky-500/10 hover:border-sky-500/50">
						<h3 class="text-2xl font-semibold mb-3 text-sky-500">Manufacturing Inventory System</h3>
						<p class="text-zinc-600 dark:text-zinc-400 mb-4 leading-relaxed">
							Created a custom inventory management solution with barcode scanning, real-time tracking,
							and automated reordering for a manufacturing company.
						</p>
						<div class="flex flex-wrap gap-2">
							<span class="bg-sky-500/10 text-sky-600 dark:text-sky-400 px-3 py-1 rounded-full text-sm font-medium">FileMaker</span>
							<span class="bg-sky-500/10 text-sky-600 dark:text-sky-400 px-3 py-1 rounded-full text-sm font-medium">Barcode Scanning</span>
							<span class="bg-sky-500/10 text-sky-600 dark:text-sky-400 px-3 py-1 rounded-full text-sm font-medium">Automation</span>
						</div>
					</div>

					<!-- Story 3 -->
					<div class="group p-8 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 shadow-lg shadow-zinc-600/5 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-sky-500/10 hover:border-sky-500/50">
						<h3 class="text-2xl font-semibold mb-3 text-sky-500">E-Commerce Platform</h3>
						<p class="text-zinc-600 dark:text-zinc-400 mb-4 leading-relaxed">
							Built a custom e-commerce platform integrated with FileMaker for seamless inventory and order management.
						</p>
						<div class="flex flex-wrap gap-2">
							<span class="bg-sky-500/10 text-sky-600 dark:text-sky-400 px-3 py-1 rounded-full text-sm font-medium">Web Development</span>
							<span class="bg-sky-500/10 text-sky-600 dark:text-sky-400 px-3 py-1 rounded-full text-sm font-medium">FileMaker Integration</span>
							<span class="bg-sky-500/10 text-sky-600 dark:text-sky-400 px-3 py-1 rounded-full text-sm font-medium">E-Commerce</span>
						</div>
					</div>
				</div>
			</section>

			<!-- CTA Section -->
			<CTA
				title="Ready to Start Your Project?"
				description="Let's discuss how we can help transform your business."
				buttonText="Contact Us"
				buttonHref="/contact"
			/>
</PageLayout>

