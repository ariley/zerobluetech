---
import PageLayout from '../layouts/PageLayout.astro';

const consultationUrl = 'https://calendly.com/agnesriley';

const proofPoints = [
	{
		metric: '$1M+',
		label: 'annual savings',
		body: 'Improved employee productivity by saving at least two hours per day per employee, generating over $1M in annual savings.',
	},
	{
		metric: '15+',
		label: 'complex FileMaker systems',
		body: 'Delivered more than 15 complex FileMaker Pro systems and increased productivity by approximately 25%.',
	},
	{
		metric: '100%',
		label: 'FileMaker Server uptime',
		body: 'Migrated a FileMaker Server from Mac to Linux, improving stability and achieving 100% uptime for more than 100 users.',
	},
	{
		metric: '2008',
		label: 'RadFM hosting started',
		href: 'https://radfm.cloud',
		body: 'Operates a FileMaker Server hosting business using cloud infrastructure, alongside consulting and system work.',
	},
];

const evidence = [
	{
		title: 'FileMaker audits and system improvement',
		body: 'Long-running systems need evidence before they need more code. ZeroBlue brings process analysis, schema review, workflow diagnosis, and practical prioritization to existing FileMaker applications.',
		points: [
			'Process analysis and workflow improvement',
			'FileMaker schema, scripting, layout, and integration review',
			'Data analysis, normalization, and operational cleanup',
		],
	},
	{
		title: 'AI, analytics, and platform strategy',
		body: 'Recent work includes FileMaker platform product management at Claris, analytics initiatives, and modern AI education applied to practical FileMaker use cases.',
		points: [
			'Former Claris Senior Product Manager for platform-level initiatives',
			'Customer feedback, analytics, and market research for roadmap decisions',
			'AI-assisted workflows, summaries, analysis, and data access planning',
		],
	},
	{
		title: 'Server setup, reliability, and monitoring',
		body: 'FileMaker systems depend on the server as much as the file. The work includes FileMaker Server setup, maintenance, cloud hosting, SSL, backups, logs, and operational reliability.',
		points: [
			'FileMaker Server environments on Mac, Windows, and Linux',
			'AWS, Google Cloud, and hosted FileMaker infrastructure',
			'Backups, schedules, logs, SSL, uptime, and supportability',
		],
	},
	{
		title: 'Regulated and business-critical systems',
		body: 'Experience includes FileMaker systems built for organizations where correctness, documentation, validation, and uptime matter.',
		points: [
			'21 CFR Part 11 and FDA software validation principles',
			'Lawrence Livermore National Laboratory software and analytics work',
			'Operational systems for sales, shipping, document, and internal workflow teams',
		],
	},
	{
		title: 'Integrations and connected systems',
		body: 'FileMaker rarely stands alone. ZeroBlue has connected FileMaker to web apps, APIs, JavaScript interfaces, analytics tools, and external business systems.',
		points: [
			'JSON, JavaScript, ESS, XML, and API integration work',
			'Bi-directional FileMaker and web application sync',
			'Mobile, desktop, and web-facing FileMaker workflows',
		],
	},
	{
		title: 'Apple ecosystem and FileMaker history',
		body: 'The background spans Apple departments, Beezwax, Soliant, Claris, independent consulting, and FileMaker work reaching back to early professional roles.',
		points: [
			'FileMaker solutions for Apple departments and external clients',
			'Soliant and Beezwax FileMaker consulting experience',
			'33 years of FileMaker experience across business, server, and product work',
		],
	},
];

const engagements = [
	{
		title: 'When the file is slow',
		body: 'Review scripts, schema, calculations, layouts, server behavior, and data volume before deciding what to rewrite.',
	},
	{
		title: 'When AI is on the roadmap',
		body: 'Identify what data is ready, what needs cleanup, and which AI workflow is useful enough to justify implementation.',
	},
	{
		title: 'When the server feels risky',
		body: 'Check backups, SSL, logs, schedules, hardware, hosting, uptime, and monitoring before reliability becomes urgent.',
	},
];
---

<PageLayout
	title="FileMaker Experience & Results - ZeroBlue"
	description="Resume-backed FileMaker consulting proof points: system savings, server reliability, Claris product strategy, AI, audits, integrations, and monitoring."
	heroTitle="FileMaker Experience Backed by Practical Results"
	heroSubtitle="A truthful view of the systems, savings, server work, product strategy, and FileMaker consulting experience behind ZeroBlue."
	heroEyebrow="Evidence, Not Placeholder Portfolio"
>
	<section class="py-12 lg:py-16">
		<div class="grid gap-6 lg:grid-cols-4">
			{proofPoints.map((proof) => (
				<article class="surface-card surface-card-hover p-7">
					<div class="text-4xl font-bold tracking-tight text-sky-700 dark:text-sky-300">{proof.metric}</div>
					<h2 class="mt-2 text-lg font-bold uppercase tracking-wider text-slate-950 dark:text-white">
						{proof.href ? (
							<a href={proof.href} target="_blank" rel="noopener noreferrer" class="accent-link">
								{proof.label}
							</a>
						) : (
							proof.label
						)}
					</h2>
					<p class="mt-4 leading-7 text-slate-700 dark:text-slate-300">{proof.body}</p>
				</article>
			))}
		</div>
	</section>

	<section class="py-12 lg:py-16">
		<div class="mx-auto max-w-3xl text-center">
			<p class="text-sm font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-300">What the experience supports</p>
			<h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white md:text-4xl">
				FileMaker consulting grounded in real operational work.
			</h2>
		</div>

		<div class="mt-10 grid gap-6 lg:grid-cols-2">
			{evidence.map((item) => (
				<article class="surface-card surface-card-hover p-7">
					<h3 class="text-2xl font-bold tracking-tight text-slate-950 dark:text-white">{item.title}</h3>
					<p class="mt-4 leading-7 text-slate-700 dark:text-slate-300">{item.body}</p>
					<ul class="mt-6 space-y-3">
						{item.points.map((point) => (
							<li class="flex gap-3 text-slate-700 dark:text-slate-300">
								<span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-teal-500"></span>
								<span>{point}</span>
							</li>
						))}
					</ul>
				</article>
			))}
		</div>
	</section>

	<section class="py-12 lg:py-16">
		<div class="surface-card overflow-hidden">
			<div class="color-strip"></div>
			<div class="grid gap-8 p-8 lg:grid-cols-[0.8fr_1.2fr] lg:p-10">
				<div>
					<p class="text-sm font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-300">Practical engagement types</p>
					<h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white">Useful when the next step is unclear.</h2>
				</div>
				<div class="grid gap-4 md:grid-cols-3">
					{engagements.map((engagement) => (
						<div class="rounded-xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-700 dark:bg-slate-900/70">
							<h3 class="font-bold text-slate-950 dark:text-white">{engagement.title}</h3>
							<p class="mt-3 leading-7 text-slate-700 dark:text-slate-300">{engagement.body}</p>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<section class="rounded-2xl bg-slate-950 p-8 text-white shadow-xl shadow-slate-900/20 dark:bg-sky-950 lg:p-12">
		<div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
			<div>
				<p class="text-sm font-semibold uppercase tracking-wider text-teal-300">Need a senior FileMaker review?</p>
				<h2 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl">Start with a practical consultation.</h2>
				<p class="mt-4 max-w-3xl text-lg leading-8 text-slate-300">
					Bring the system, symptoms, goals, or risks. ZeroBlue can help decide whether the next step is an audit,
					AI integration plan, server review, <a href="https://fmdojo.com" target="_blank" rel="noopener noreferrer" class="text-teal-200 underline decoration-teal-300/60 underline-offset-4 transition hover:text-white">FMDojo</a> monitoring setup, or targeted stability work.
				</p>
			</div>
			<a href={consultationUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-xl bg-white px-6 py-3 font-semibold text-slate-950 shadow-lg transition hover:-translate-y-0.5 hover:bg-sky-50">
				Schedule a Consultation
			</a>
		</div>
	</section>
</PageLayout>
