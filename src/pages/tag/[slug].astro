---
import BaseHead from '@/components/BaseHead.astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import BlogArchive from '@/components/BlogArchive.astro'
import { urlifyToken, sortedPosts } from '@/js/util.js'
import { SITE_TITLE, SITE_DESCRIPTION } from '@/config.ts'

export async function getStaticPaths() {
  const postImportResult = import.meta.glob('../../posts/*.{md,mdx}', { eager: true })
  const posts = sortedPosts(Object.values(postImportResult))
  const tags = new Set()
  posts.forEach(post => {
    post.frontmatter.tags?.map(urlifyToken).forEach(c => tags.add(c))
  })
  return Array.from(tags).map(tag => {
    const tagPosts = posts.filter(post => post.frontmatter.tags?.map(urlifyToken).includes(tag))
    return {
      params: { slug: tag },
      props: {
        posts: tagPosts,
        tag: tagPosts[0].frontmatter.tags?.find(x => urlifyToken(x) === tag)
      }
    }
  })
}
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead title={`${Astro.props.tag} » ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body class="site-body">
    <Header />
    <section class="hero-panel">
      <div class="hero-grid">
        <div>
          <div class="eyebrow"><span class="h-2 w-2 rounded-full bg-teal-400"></span>Tag archive</div>
          <h1 class="hero-title">{Astro.props.tag}</h1>
          <p class="hero-subtitle">Articles tagged with {Astro.props.tag}.</p>
        </div>
      </div>
    </section>
    <main class="site-main pt-12">
      <BlogArchive posts={Astro.props.posts} />
    </main>
    <Footer />
  </body>
</html>
