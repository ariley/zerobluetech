---
import PageLayout from '../layouts/PageLayout.astro';

const consultationUrl = 'https://calendly.com/agnesriley';

const services = [
	{
		title: 'FileMaker System & App Audits',
		description:
			'Review the parts of your FileMaker system that determine whether it can be trusted, extended, and supported.',
		points: [
			'Schema, scripts, layouts, security, integrations, and performance risks',
			'Prioritized findings and practical recommendations',
		],
	},
	{
		title: 'FileMaker AI Integration',
		description:
			'Add useful AI where it belongs: close to your data, workflows, scripts, and operational decisions.',
		points: [
			'Connect FileMaker to AI workflows',
			'Add AI-assisted search, summaries, data access, automation, and analysis',
		],
	},
	{
		title: 'FileMaker Server Setup & Optimization',
		description:
			'Configure and harden FileMaker Server so backups, SSL, schedules, logs, and performance are not left to chance.',
		points: [
			'FileMaker Server configuration and review',
			'Backups, schedules, logs, SSL, performance, and reliability checks',
		],
	},
	{
		title: 'Performance & Stability Consulting',
		description:
			'Find the real causes behind slow files, brittle scripts, recurring crashes, and architecture that has become risky.',
		points: [
			'Slow files, bad schema, and script bottlenecks',
			'Server issues, integration failures, and risky architecture',
		],
	},
	{
		title: 'FMDojo-Powered Monitoring Setup',
		description:
			'Use FMDojo to make FileMaker system health visible before small issues become operational problems.',
		points: [
			'Monitoring, alerts, log analysis, and server visibility',
			'Practical setup for ongoing review and faster troubleshooting',
		],
	},
];

const credibility = [
	'35+ years FileMaker experience',
	'Former Claris Senior Product Manager',
	'FileMaker infrastructure, AI, and product strategy experience',
	'Creator of FMDojo',
];

const ctas = [
	{
		title: 'Need a FileMaker audit?',
		body: 'Get a senior review of the system you already depend on, with findings you can act on.',
	},
	{
		title: 'Want to add AI to your FileMaker system?',
		body: 'Identify where AI can help safely and where the underlying data or workflow needs cleanup first.',
	},
	{
		title: 'Is your server stable and properly monitored?',
		body: 'Review the server, backups, logs, SSL, and monitoring setup before reliability becomes urgent.',
	},
];
---

<PageLayout
	title="Senior FileMaker Consulting Services - ZeroBlue"
	description="Senior FileMaker consulting for audits, AI integration, server setup, performance, stability, and FMDojo-powered monitoring."
	heroTitle="Senior FileMaker Consulting for Systems That Matter"
	heroSubtitle="We help businesses audit, modernize, AI-enable, and stabilize FileMaker systems without guessing what is broken."
	heroEyebrow="FileMaker Consulting"
>
	<section class="py-12 lg:py-16">
		<div class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-stretch">
			<div class="surface-card p-8 lg:p-10">
				<p class="text-sm font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-300">Senior review, practical fixes</p>
				<h2 class="mt-4 text-3xl font-bold tracking-tight text-slate-950 dark:text-white md:text-4xl">
					Get clarity before you spend more money on the wrong problem.
				</h2>
				<p class="mt-5 text-lg leading-8 text-slate-700 dark:text-slate-300">
					ZeroBlue works on the FileMaker systems that businesses already rely on: legacy apps, production servers,
					AI-ready workflows, unstable deployments, and systems that need an expert audit before the next decision.
				</p>
				<div class="mt-8 flex flex-col gap-3 sm:flex-row">
					<a href={consultationUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
						Schedule a Consultation
					</a>
					<a href="#services" class="btn-secondary">
						View Services
					</a>
				</div>
			</div>

			<div class="surface-card p-8 lg:p-10">
				<h2 class="text-2xl font-bold tracking-tight text-slate-950 dark:text-white">Where ZeroBlue focuses</h2>
				<div class="mt-6 space-y-4">
					<div class="rounded-xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-700 dark:bg-slate-900/70">
						<h3 class="font-semibold text-slate-950 dark:text-white">FileMaker systems</h3>
						<p class="mt-2 text-slate-700 dark:text-slate-300">The focus is FileMaker architecture, data, automation, server health, and operational risk.</p>
					</div>
					<div class="rounded-xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-700 dark:bg-slate-900/70">
						<h3 class="font-semibold text-slate-950 dark:text-white">Business-critical operations</h3>
						<p class="mt-2 text-slate-700 dark:text-slate-300">The work centers on business systems, integrations, AI workflows, and FileMaker infrastructure.</p>
					</div>
					<div class="rounded-xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-700 dark:bg-slate-900/70">
						<h3 class="font-semibold text-slate-950 dark:text-white">Senior diagnosis</h3>
						<p class="mt-2 text-slate-700 dark:text-slate-300">You bring in ZeroBlue when the system matters and the diagnosis needs to be right.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section id="services" class="py-12 lg:py-16">
		<div class="mx-auto max-w-3xl text-center">
			<p class="text-sm font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-300">Primary services</p>
			<h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white md:text-4xl">
				FileMaker consulting for the systems behind the business.
			</h2>
		</div>

		<div class="mt-10 grid gap-6 lg:grid-cols-2">
			{services.map((service, index) => (
				<article class:list={[
					'surface-card surface-card-hover p-7',
					index === 0 ? 'lg:col-span-2 lg:grid lg:grid-cols-[0.75fr_1fr] lg:gap-8' : '',
				]}>
					<div>
						<div class="mb-5 inline-flex h-11 w-11 items-center justify-center rounded-xl bg-sky-100 text-lg font-bold text-sky-700 dark:bg-sky-500/15 dark:text-sky-200">
							{index + 1}
						</div>
						<h3 class="text-2xl font-bold tracking-tight text-slate-950 dark:text-white">{service.title}</h3>
						<p class="mt-4 leading-7 text-slate-700 dark:text-slate-300">{service.description}</p>
					</div>
					<ul class="mt-6 space-y-3 lg:mt-0">
						{service.points.map((point) => (
							<li class="flex gap-3 text-slate-700 dark:text-slate-300">
								<span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-teal-500"></span>
								<span>{point}</span>
							</li>
						))}
					</ul>
				</article>
			))}
		</div>
	</section>

	<section class="py-12 lg:py-16">
		<div class="surface-card overflow-hidden">
			<div class="color-strip"></div>
			<div class="grid gap-8 p-8 lg:grid-cols-[0.8fr_1.2fr] lg:p-10">
				<div>
					<p class="text-sm font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-300">Credibility</p>
					<h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white">Senior FileMaker judgment.</h2>
					<p class="mt-4 leading-7 text-slate-700 dark:text-slate-300">
						The goal is not to sell a generic package. It is to understand the system, identify the real constraints,
						and recommend the highest-leverage next steps.
					</p>
				</div>
				<div class="grid gap-4 sm:grid-cols-2">
					{credibility.map((item) => (
						<div class="rounded-xl border border-slate-200 bg-slate-50 p-5 font-semibold text-slate-900 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-100">
							{item}
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<section class="py-12 lg:py-16">
		<div class="grid gap-6 lg:grid-cols-3">
			{ctas.map((cta) => (
				<div class="surface-card p-7">
					<h2 class="text-2xl font-bold tracking-tight text-slate-950 dark:text-white">{cta.title}</h2>
					<p class="mt-4 leading-7 text-slate-700 dark:text-slate-300">{cta.body}</p>
					<a href={consultationUrl} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex font-semibold text-sky-700 transition hover:text-teal-700 dark:text-sky-300 dark:hover:text-teal-200">
						Schedule a Consultation
					</a>
				</div>
			))}
		</div>
	</section>

	<section class="rounded-2xl bg-slate-950 p-8 text-white shadow-xl shadow-slate-900/20 dark:bg-sky-950 lg:p-12">
		<div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
			<div>
				<p class="text-sm font-semibold uppercase tracking-wider text-teal-300">Start with the system you have</p>
				<h2 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl">Schedule a senior FileMaker consultation.</h2>
				<p class="mt-4 max-w-3xl text-lg leading-8 text-slate-300">
					Bring the symptoms, the goals, or the system history. We will help identify where an audit, AI integration,
					server review, or monitoring setup belongs in the next step.
				</p>
			</div>
			<a href={consultationUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-xl bg-white px-6 py-3 font-semibold text-slate-950 shadow-lg transition hover:-translate-y-0.5 hover:bg-sky-50">
				Schedule a Consultation
			</a>
		</div>
	</section>
</PageLayout>
