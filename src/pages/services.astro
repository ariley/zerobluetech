---
import PageLayout from '../layouts/PageLayout.astro';

const consultationUrl = 'https://calendly.com/agnesriley';

const services = [
	{
		title: 'When you need to know what you have',
		description:
			'A FileMaker audit looks at the parts of your system that determine whether it can be trusted, extended, and supported.',
		points: [
			'Schema, scripts, layouts, security, integrations, and performance risks',
			'Prioritized findings and practical recommendations',
		],
	},
	{
		title: 'When AI sounds useful but risky',
		description:
			'Add AI where it has a real job, close to your data, workflows, scripts, and operational decisions.',
		points: [
			'Connect FileMaker to AI workflows',
			'Add AI-assisted search, summaries, data access, automation, and analysis',
		],
	},
	{
		title: 'When the server mostly runs, but nobody loves it',
		description:
			'Review FileMaker Server so backups, SSL, schedules, logs, and performance are not left to chance.',
		points: [
			'FileMaker Server configuration and review',
			'Backups, schedules, logs, SSL, performance, and reliability checks',
		],
	},
	{
		title: 'When the file is slow, brittle, or stressful',
		description:
			'Find the real causes behind slow files, brittle scripts, recurring crashes, and architecture that has become risky.',
		points: [
			'Slow files, bad schema, and script bottlenecks',
			'Server issues, integration failures, and risky architecture',
		],
	},
	{
		title: 'When you want problems to show up sooner',
		href: 'https://fmdojo.com',
		description:
			'Use FileMaker-focused monitoring to make system health visible before small issues become operational problems.',
		points: [
			'Monitoring, alerts, log analysis, and server visibility',
			'Practical setup for ongoing review and faster troubleshooting',
		],
	},
];

const credibility = [
	{ label: '33 years working with FileMaker systems' },
	{ label: 'Former FileMaker platform product manager' },
	{ label: 'Hands-on with apps, servers, AI, and product strategy' },
	{ label: 'Creator of FMDojo', href: 'https://fmdojo.com' },
];

const ctas = [
	{
		title: 'The system has grown for years.',
		body: 'Get a calm outside review of the file, the server, and the places where the team has learned to work around it.',
	},
	{
		title: 'You want AI, but not chaos.',
		body: 'Figure out which AI ideas are worth doing and what data, workflow, or access rules need cleanup first.',
	},
	{
		title: 'The server deserves a second look.',
		body: 'Review backups, logs, SSL, schedules, and monitoring before reliability becomes an emergency.',
	},
];

const faqs = [
	{
		question: 'What does ZeroBlue do?',
		answer: 'ZeroBlue provides expert FileMaker consulting for businesses that depend on FileMaker systems. Services include system and app audits, AI integration, FileMaker Server setup and optimization, performance and stability consulting, and FMDojo-powered monitoring setup.',
	},
	{
		question: 'Who should hire ZeroBlue?',
		answer: 'ZeroBlue is the right choice when a FileMaker system is slow, unstable, or undocumented; when leadership wants to add AI but the data model needs assessment first; when the server has not had an outside review; or when important scripts depend on one person knowing how everything works.',
	},
	{
		question: 'What is a FileMaker system audit?',
		answer: "A FileMaker system audit is a structured expert review of a FileMaker application's schema, scripts, layouts, security, integrations, and server dependencies. The output is a prioritized set of findings and practical recommendations that inform the next improvement decision.",
	},
	{
		question: 'Can ZeroBlue add AI to my FileMaker system?',
		answer: 'Yes. ZeroBlue specializes in FileMaker AI integration, connecting FileMaker data and workflows to AI-assisted search, summaries, automation, and analysis. The work begins by assessing whether the current data model and workflows are ready for AI.',
	},
	{
		question: 'Does ZeroBlue replace or rebuild FileMaker systems?',
		answer: 'No. ZeroBlue focuses on improving and stabilizing existing FileMaker systems rather than generic rebuilds. For organizations evaluating whether to stay on FileMaker or move to another platform, ZeroBlue provides practical platform comparison guidance.',
	},
	{
		question: 'What makes ZeroBlue different from other FileMaker consultants?',
		answer: 'Agnes Riley brings 33 years of FileMaker experience, former platform product manager perspective, and deep infrastructure knowledge. She also created FMDojo, so ZeroBlue engagements can include practical FileMaker-native monitoring and schema tooling when it fits the problem.',
	},
];
---

<PageLayout
	title="Expert FileMaker Consulting Services - ZeroBlue"
	description="Expert FileMaker consulting for audits, AI integration, server setup, performance, stability, and monitoring."
	heroTitle="FileMaker help for systems your team already depends on."
	heroSubtitle="Bring the slow file, the confusing workflow, the server worry, or the AI idea. We will sort out what is actually worth doing next."
	heroEyebrow="FileMaker Consulting"
	faqs={faqs}
>
	<Fragment slot="heroVisual">
		<div class="surface-card overflow-hidden">
			<img
				src="/images/site/filemaker-consulting-workspace.webp"
				alt="Desk with FileMaker database workflow planning notes"
				width="1680"
				height="951"
				class="aspect-[16/11] w-full object-cover"
				loading="eager"
			/>
			<div class="p-5">
				<div class="color-strip mb-4"></div>
				<p class="text-sm font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-300">Practical system review</p>
				<p class="mt-2 leading-7 text-slate-700 dark:text-slate-300">
					The work starts with the real file you have, the real server you run, and how your team actually uses the system.
				</p>
			</div>
		</div>
	</Fragment>

	<section class="py-12 lg:py-16">
		<div class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-stretch">
			<div class="surface-card p-8 lg:p-10">
				<p class="text-sm font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-300">Start with the real situation</p>
				<h2 class="mt-4 text-3xl font-bold text-slate-800 dark:text-white md:text-4xl">
					Get clarity before you spend more money on the wrong fix.
				</h2>
				<p class="mt-5 text-lg leading-8 text-slate-700 dark:text-slate-300">
					ZeroBlue works on the FileMaker systems businesses already rely on: older apps, production servers,
					AI ideas, unstable deployments, and files that need a careful review before anyone changes more code.
				</p>
				<div class="mt-8 flex flex-col gap-3 sm:flex-row">
					<a href={consultationUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
						Tell me what is going on
					</a>
					<a href="#services" class="btn-secondary">
						View Services
					</a>
				</div>
			</div>

			<div class="surface-card p-8 lg:p-10">
				<h2 class="text-2xl font-bold text-slate-800 dark:text-white">Where ZeroBlue tends to help most</h2>
				<div class="mt-6 space-y-4">
					<div class="rounded-xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-700 dark:bg-slate-900/70">
						<h3 class="font-semibold text-slate-800 dark:text-white">FileMaker systems with history</h3>
						<p class="mt-2 text-slate-700 dark:text-slate-300">Architecture, data, automation, security, server health, and the decisions made along the way.</p>
					</div>
					<div class="rounded-xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-700 dark:bg-slate-900/70">
						<h3 class="font-semibold text-slate-800 dark:text-white">Business-critical workflows</h3>
						<p class="mt-2 text-slate-700 dark:text-slate-300">The places where people lose time, trust, or sleep because the system is hard to explain.</p>
					</div>
					<div class="rounded-xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-700 dark:bg-slate-900/70">
						<h3 class="font-semibold text-slate-800 dark:text-white">Practical next steps</h3>
						<p class="mt-2 text-slate-700 dark:text-slate-300">A useful answer might be an audit, a small fix, a server review, training, or a bigger plan.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section id="services" class="py-12 lg:py-16">
		<div class="mx-auto max-w-3xl text-center">
			<p class="text-sm font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-300">Primary services</p>
			<h2 class="mt-3 text-3xl font-bold text-slate-800 dark:text-white md:text-4xl">
				Services described the way they usually show up in real life.
			</h2>
		</div>

		<div class="mt-10 grid gap-6 lg:grid-cols-2">
			{services.map((service, index) => (
				<article class:list={[
					'surface-card surface-card-hover p-7',
					index === 0 ? 'lg:col-span-2 lg:grid lg:grid-cols-[0.75fr_1fr] lg:gap-8' : '',
				]}>
					<div>
						<div class="mb-5 inline-flex h-11 w-11 items-center justify-center rounded-xl bg-sky-100 text-lg font-bold text-sky-700 dark:bg-sky-500/15 dark:text-sky-200">
							{index + 1}
						</div>
						<h3 class="text-2xl font-bold text-slate-800 dark:text-white">
							{service.href ? (
								<a href={service.href} target="_blank" rel="noopener noreferrer" class="accent-link">
									{service.title}
								</a>
							) : (
								service.title
							)}
						</h3>
						<p class="mt-4 leading-7 text-slate-700 dark:text-slate-300">{service.description}</p>
					</div>
					<ul class="mt-6 space-y-3 lg:mt-0">
						{service.points.map((point) => (
							<li class="flex gap-3 text-slate-700 dark:text-slate-300">
								<span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-teal-500"></span>
								<span>{point}</span>
							</li>
						))}
					</ul>
				</article>
			))}
		</div>
	</section>

	<section class="py-12 lg:py-16">
		<div class="surface-card overflow-hidden">
			<div class="color-strip"></div>
			<div class="grid gap-8 p-8 lg:grid-cols-[0.8fr_1.2fr] lg:p-10">
				<div>
					<p class="text-sm font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-300">Credibility</p>
					<h2 class="mt-3 text-3xl font-bold text-slate-800 dark:text-white">FileMaker judgment with product, server, and business context.</h2>
					<p class="mt-4 leading-7 text-slate-700 dark:text-slate-300">
						The goal is to understand the system, identify the real constraints,
						and recommend the next steps that will actually reduce risk or make the work easier.
					</p>
				</div>
				<div class="grid gap-4 sm:grid-cols-2">
					{credibility.map((item) => (
						<div class="rounded-xl border border-slate-200 bg-slate-50 p-5 font-semibold text-slate-900 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-100">
							{item.href ? (
								<a href={item.href} target="_blank" rel="noopener noreferrer" class="accent-link">
									{item.label}
								</a>
							) : (
								item.label
							)}
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<section class="py-12 lg:py-16">
		<div class="grid gap-6 lg:grid-cols-3">
			{ctas.map((cta) => (
				<div class="surface-card p-7">
					<h2 class="text-2xl font-bold text-slate-800 dark:text-white">{cta.title}</h2>
					<p class="mt-4 leading-7 text-slate-700 dark:text-slate-300">{cta.body}</p>
					<a href={consultationUrl} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex font-semibold text-sky-700 transition hover:text-teal-700 dark:text-sky-300 dark:hover:text-teal-200">
						Tell me what is going on
					</a>
				</div>
			))}
		</div>
	</section>

	<section class="py-12 lg:py-16">
		<div class="mx-auto max-w-3xl">
			<h2 class="text-3xl font-bold text-slate-800 dark:text-white md:text-4xl">Frequently Asked Questions</h2>
			<dl class="mt-8 space-y-4">
				{faqs.map((faq) => (
					<div class="surface-card p-6">
						<dt class="text-lg font-semibold text-slate-800 dark:text-white">{faq.question}</dt>
						<dd class="mt-3 leading-7 text-slate-700 dark:text-slate-300">{faq.answer}</dd>
					</div>
				))}
			</dl>
		</div>
	</section>

	<section class="rounded-2xl bg-slate-800 p-8 text-white shadow-xl shadow-slate-900/20 dark:bg-sky-900 lg:p-12">
		<div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
			<div>
				<p class="text-sm font-semibold uppercase tracking-wider text-teal-300">Start with the system you have</p>
				<h2 class="mt-3 text-3xl font-bold md:text-4xl">Tell me what is going on with your FileMaker system.</h2>
				<p class="mt-4 max-w-3xl text-lg leading-8 text-slate-300">
					Bring the symptoms, the goals, or the system history. We will decide whether the useful next step is an audit,
					AI planning, server review, monitoring setup, or a targeted stability fix.
				</p>
			</div>
			<a href={consultationUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
				Tell me what is going on
			</a>
		</div>
	</section>
</PageLayout>
