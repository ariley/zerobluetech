---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
	title="Services - ZeroBlue"
	description="Comprehensive FileMaker, web, and mobile development services"
	heroTitle="Our Services"
	heroSubtitle="At ZeroBlue Technology Solutions, we shine at building solutions that do exactly what you need them to do."
>

			<!-- Main Services Grid -->
			<section class="mb-16">
				<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
					<!-- FileMaker Development -->
					<div class="group p-8 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 shadow-lg shadow-zinc-600/5 transition-all duration-300 hover:-translate-y-2 hover:shadow-xl hover:shadow-sky-500/10 hover:border-sky-500/50">
						<div class="mb-6 w-14 h-14 rounded-2xl bg-sky-500/10 flex items-center justify-center group-hover:scale-110 group-hover:rotate-3 transition-all duration-300">
							<svg class="w-7 h-7 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path>
							</svg>
						</div>
						<h2 class="text-2xl font-bold mb-4 text-zinc-800 dark:text-zinc-200">FileMaker Development</h2>
						<p class="text-zinc-600 dark:text-zinc-400 mb-6 leading-relaxed">
							Your business is unique. The software that runs your operations should be, too, in order to best answer your specific needs.
						</p>
						<a href="/filemaker-development" class="inline-flex items-center gap-2 text-sky-500 hover:text-sky-600 dark:hover:text-sky-400 font-semibold transition-all group-hover:gap-3">
							Learn More
							<svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
							</svg>
						</a>
					</div>

					<!-- Web Development -->
					<div class="group p-8 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 shadow-lg shadow-zinc-600/5 transition-all duration-300 hover:-translate-y-2 hover:shadow-xl hover:shadow-sky-500/10 hover:border-sky-500/50">
						<div class="mb-6 w-14 h-14 rounded-2xl bg-sky-500/10 flex items-center justify-center group-hover:scale-110 group-hover:rotate-3 transition-all duration-300">
							<svg class="w-7 h-7 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
							</svg>
						</div>
						<h2 class="text-2xl font-bold mb-4 text-zinc-800 dark:text-zinc-200">Web Development</h2>
						<p class="text-zinc-600 dark:text-zinc-400 mb-6 leading-relaxed">
							We create responsive WordPress or custom-coded CMS websites and web apps to manage all aspects of businesses.
						</p>
						<a href="/web-development" class="inline-flex items-center gap-2 text-sky-500 hover:text-sky-600 dark:hover:text-sky-400 font-semibold transition-all group-hover:gap-3">
							Learn More
							<svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
							</svg>
						</a>
					</div>

					<!-- Mobile Development -->
					<div class="group p-8 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 shadow-lg shadow-zinc-600/5 transition-all duration-300 hover:-translate-y-2 hover:shadow-xl hover:shadow-sky-500/10 hover:border-sky-500/50">
						<div class="mb-6 w-14 h-14 rounded-2xl bg-sky-500/10 flex items-center justify-center group-hover:scale-110 group-hover:rotate-3 transition-all duration-300">
							<svg class="w-7 h-7 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
							</svg>
						</div>
						<h2 class="text-2xl font-bold mb-4 text-zinc-800 dark:text-zinc-200">Mobile Development</h2>
						<p class="text-zinc-600 dark:text-zinc-400 mb-6 leading-relaxed">
							Do you need to access your data from your truck or the train or your car? We create mobile applications for on-the-go access.
						</p>
						<a href="/filemaker-development" class="inline-flex items-center gap-2 text-sky-500 hover:text-sky-600 dark:hover:text-sky-400 font-semibold transition-all group-hover:gap-3">
							Learn More
							<svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
							</svg>
						</a>
					</div>

					<!-- FileMaker Licensing -->
					<div class="group p-8 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 shadow-lg shadow-zinc-600/5 transition-all duration-300 hover:-translate-y-2 hover:shadow-xl hover:shadow-sky-500/10 hover:border-sky-500/50">
						<div class="mb-6 w-14 h-14 rounded-2xl bg-sky-500/10 flex items-center justify-center group-hover:scale-110 group-hover:rotate-3 transition-all duration-300">
							<svg class="w-7 h-7 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
							</svg>
						</div>
						<h2 class="text-2xl font-bold mb-4 text-zinc-800 dark:text-zinc-200">FileMaker Licensing</h2>
						<p class="text-zinc-600 dark:text-zinc-400 mb-6 leading-relaxed">
							As a member of the FileMaker Business Alliance, ZeroBlue can offer significant discounts on licensing for 5 or more copies.
						</p>
						<a href="/filemaker-licenses" class="inline-flex items-center gap-2 text-sky-500 hover:text-sky-600 dark:hover:text-sky-400 font-semibold transition-all group-hover:gap-3">
							Learn More
							<svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
							</svg>
						</a>
					</div>

					<!-- Web Hosting -->
					<div class="group p-8 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 shadow-lg shadow-zinc-600/5 transition-all duration-300 hover:-translate-y-2 hover:shadow-xl hover:shadow-sky-500/10 hover:border-sky-500/50">
						<div class="mb-6 w-14 h-14 rounded-2xl bg-sky-500/10 flex items-center justify-center group-hover:scale-110 group-hover:rotate-3 transition-all duration-300">
							<svg class="w-7 h-7 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
							</svg>
						</div>
						<h2 class="text-2xl font-bold mb-4 text-zinc-800 dark:text-zinc-200">Web Hosting</h2>
						<p class="text-zinc-600 dark:text-zinc-400 mb-6 leading-relaxed">
							Scalable web hosting with email, 5GB storage space, daily backups for 7 days, Plesk client dashboard access, and webmail.
						</p>
						<a href="/contact" class="inline-flex items-center gap-2 text-sky-500 hover:text-sky-600 dark:hover:text-sky-400 font-semibold transition-all group-hover:gap-3">
							Contact Us
							<svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
							</svg>
						</a>
					</div>

					<!-- FileMaker Hosting -->
					<div class="group p-8 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 shadow-lg shadow-zinc-600/5 transition-all duration-300 hover:-translate-y-2 hover:shadow-xl hover:shadow-sky-500/10 hover:border-sky-500/50">
						<div class="mb-6 w-14 h-14 rounded-2xl bg-sky-500/10 flex items-center justify-center group-hover:scale-110 group-hover:rotate-3 transition-all duration-300">
							<svg class="w-7 h-7 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"></path>
							</svg>
						</div>
						<h2 class="text-2xl font-bold mb-4 text-zinc-800 dark:text-zinc-200">FileMaker Hosting</h2>
						<p class="text-zinc-600 dark:text-zinc-400 mb-6 leading-relaxed">
							Shared and dedicated FileMaker hosting on Mac Minis in Atlanta, GA. Shared or dedicated SuperContainer hosting on Linode servers.
						</p>
						<a href="/filemaker-hosting" class="inline-flex items-center gap-2 text-sky-500 hover:text-sky-600 dark:hover:text-sky-400 font-semibold transition-all group-hover:gap-3">
							Learn More
							<svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
							</svg>
						</a>
					</div>
				</div>
			</section>

			<!-- Why Choose Us -->
			<section class="mb-16">
				<div class="bg-zinc-50 dark:bg-zinc-800 rounded-lg shadow-lg p-8">
					<h2 class="text-3xl font-bold mb-6 text-center text-zinc-700 dark:text-zinc-300">Why Choose ZeroBlue?</h2>
					<div class="grid md:grid-cols-2 gap-8">
						<div>
							<h3 class="text-xl font-semibold mb-3 text-zinc-700 dark:text-zinc-300">Ease of Use</h3>
							<p class="text-zinc-700 dark:text-zinc-400">
								We design with an unwavering focus on ease of use paired with crisp interfaces that your team will love to use.
							</p>
						</div>
						<div>
							<h3 class="text-xl font-semibold mb-3 text-zinc-700 dark:text-zinc-300">Passionate Team</h3>
							<p class="text-zinc-700 dark:text-zinc-400">
								We're passionate about what we do and take pride in our results. Your success is our success.
							</p>
						</div>
						<div>
							<h3 class="text-xl font-semibold mb-3 text-zinc-700 dark:text-zinc-300">Custom Solutions</h3>
							<p class="text-zinc-700 dark:text-zinc-400">
								Every business is unique. We build solutions tailored to your specific needs and workflows.
							</p>
						</div>
						<div>
							<h3 class="text-xl font-semibold mb-3 text-zinc-700 dark:text-zinc-300">Ongoing Support</h3>
							<p class="text-zinc-700 dark:text-zinc-400">
								We're here for you long after launch with maintenance, updates, and support when you need it.
							</p>
						</div>
					</div>
				</div>
			</section>

			<!-- CTA Section -->
			<section class="bg-gradient-to-r from-sky-400 via-blue-400 to-sky-400 dark:from-sky-500 dark:via-blue-500 dark:to-sky-500 rounded-lg shadow-xl p-12 text-center text-white">
				<h2 class="text-3xl font-bold mb-4">Have a project in mind?</h2>
				<p class="text-xl mb-8">Let's discuss how we can help your business grow.</p>
				<a href="/contact" class="inline-block bg-zinc-50 text-primary px-8 py-3 rounded-lg font-semibold hover:bg-zinc-100 transition-colors">
					Get Started
				</a>
			</section>
</PageLayout>

