---
import BaseHead from '@/components/BaseHead.astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import BlogArchive from '@/components/BlogArchive.astro'
import { urlifyToken, sortedPosts } from '@/js/util.js'
import { SITE_TITLE, SITE_DESCRIPTION } from '@/config.ts'

export async function getStaticPaths() {
  const postImportResult = import.meta.glob('../../posts/*.{md,mdx}', { eager: true })
  const posts = sortedPosts(Object.values(postImportResult))
  const authors = new Set()
  posts.forEach(post => {
    authors.add(urlifyToken(post.frontmatter.author))
  })
  return Array.from(authors).map(author => {
    const authorPosts = posts.filter(post => urlifyToken(post.frontmatter.author) === author)
    return {
      params: { slug: author },
      props: {
        posts: authorPosts,
        author: authorPosts[0].frontmatter.author
      }
    }
  })
}
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead title={`${Astro.props.author} » ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body class="site-body">
    <Header />
    <section class="hero-panel">
      <div class="hero-grid">
        <div>
          <div class="eyebrow"><span class="h-2 w-2 rounded-full bg-teal-400"></span>Author archive</div>
          <h1 class="hero-title">{Astro.props.author}</h1>
          <p class="hero-subtitle">Articles by {Astro.props.author}.</p>
        </div>
      </div>
    </section>
    <main class="site-main pt-12">
      <BlogArchive posts={Astro.props.posts} />
    </main>
    <Footer />
  </body>
</html>
