---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../config';
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
	<head>
		<BaseHead title="Web Development - ZeroBlue" description="Custom web development solutions including WordPress, CMS, and FileMaker integration" />
	</head>
	<body class="site-body">
		<Header />

		<section class="hero-panel">
			<div class="hero-grid">
				<div>
					<div class="eyebrow"><span class="h-2 w-2 rounded-full bg-teal-400"></span>Web apps and integrations</div>
					<h1 class="hero-title">Web Development</h1>
					<p class="hero-subtitle">
					We create responsive WordPress or custom-coded CMS websites and web apps to manage all aspects of businesses.
					</p>
				</div>
			</div>
		</section>

		<main class="site-main">
			<!-- Services Grid -->
			<section class="py-16">
				<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
					<!-- WordPress Development -->
					<div class="group p-6 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 shadow-lg shadow-zinc-600/5 transition-all duration-300 hover:-translate-y-2 hover:shadow-xl hover:shadow-sky-500/10 hover:border-sky-500/50">
						<h3 class="text-xl font-semibold mb-4 text-zinc-800 dark:text-zinc-200">WordPress Development</h3>
						<p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
							Custom WordPress themes and plugins tailored to your brand and business needs. Fully responsive and SEO-optimized.
						</p>
					</div>

					<!-- Custom CMS -->
					<div class="group p-6 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 shadow-lg shadow-zinc-600/5 transition-all duration-300 hover:-translate-y-2 hover:shadow-xl hover:shadow-sky-500/10 hover:border-sky-500/50">
						<h3 class="text-xl font-semibold mb-4 text-zinc-800 dark:text-zinc-200">Custom CMS</h3>
						<p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
							Build custom content management systems from scratch to perfectly match your workflow and requirements.
						</p>
					</div>

					<!-- Web Applications -->
					<div class="bg-zinc-50 dark:bg-zinc-800 rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow">
						<h3 class="text-xl font-semibold mb-3 text-zinc-700 dark:text-zinc-300">Web Applications</h3>
						<p class="text-zinc-700 dark:text-zinc-400">
							Develop powerful web applications to streamline your business processes and improve efficiency.
						</p>
					</div>

					<!-- FileMaker Integration -->
					<div class="bg-zinc-50 dark:bg-zinc-800 rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow">
						<h3 class="text-xl font-semibold mb-3 text-zinc-700 dark:text-zinc-300">FileMaker Integration</h3>
						<p class="text-zinc-700 dark:text-zinc-400">
							Connect your FileMaker database to web applications for seamless data access and management online.
						</p>
					</div>

					<!-- Responsive Design -->
					<div class="bg-zinc-50 dark:bg-zinc-800 rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow">
						<h3 class="text-xl font-semibold mb-3 text-zinc-700 dark:text-zinc-300">Responsive Design</h3>
						<p class="text-zinc-700 dark:text-zinc-400">
							Mobile-first design approach ensuring your website looks great and functions perfectly on all devices.
						</p>
					</div>

					<!-- E-Commerce -->
					<div class="bg-zinc-50 dark:bg-zinc-800 rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow">
						<h3 class="text-xl font-semibold mb-3 text-zinc-700 dark:text-zinc-300">E-Commerce Solutions</h3>
						<p class="text-zinc-700 dark:text-zinc-400">
							Build secure online stores with payment processing, inventory management, and customer accounts.
						</p>
					</div>
				</div>
			</section>

			<!-- Features Section -->
			<section class="mb-16">
				<div class="bg-zinc-50 dark:bg-zinc-800 rounded-lg shadow-lg p-8">
					<h2 class="text-3xl font-bold mb-6 text-zinc-700 dark:text-zinc-300">What We Offer</h2>
					<div class="grid md:grid-cols-2 gap-6">
						<div>
							<h3 class="text-xl font-semibold mb-3 text-zinc-700 dark:text-zinc-300">Modern Technologies</h3>
							<p class="text-zinc-700 dark:text-zinc-400">
								We use the latest web technologies and frameworks to build fast, secure, and scalable websites.
							</p>
						</div>
						<div>
							<h3 class="text-xl font-semibold mb-3 text-zinc-700 dark:text-zinc-300">SEO Optimization</h3>
							<p class="text-zinc-700 dark:text-zinc-400">
								All our websites are built with SEO best practices to help you rank higher in search results.
							</p>
						</div>
						<div>
							<h3 class="text-xl font-semibold mb-3 text-zinc-700 dark:text-zinc-300">Ongoing Support</h3>
							<p class="text-zinc-700 dark:text-zinc-400">
								We provide maintenance and support to keep your website running smoothly and securely.
							</p>
						</div>
						<div>
							<h3 class="text-xl font-semibold mb-3 text-zinc-700 dark:text-zinc-300">Custom Solutions</h3>
							<p class="text-zinc-700 dark:text-zinc-400">
								Every project is unique. We tailor our approach to meet your specific business goals.
							</p>
						</div>
					</div>
				</div>
			</section>

			<!-- CTA Section -->
			<section class="bg-gradient-to-r from-sky-400 via-blue-400 to-sky-400 dark:from-sky-500 dark:via-blue-500 dark:to-sky-500 rounded-lg shadow-xl p-12 text-center text-white">
				<h2 class="text-3xl font-bold mb-4">Ready to Build Your Website?</h2>
				<p class="text-xl mb-8">Let's create a stunning web presence for your business.</p>
				<a href="/contact" class="inline-block bg-zinc-50 text-primary px-8 py-3 rounded-lg font-semibold hover:bg-zinc-100 transition-colors">
					Get Started
				</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
