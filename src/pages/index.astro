---
import PageLayout from '../layouts/PageLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../config.ts';

const consultationUrl = 'https://calendly.com/agnesriley';

const focusAreas = [
	{
		title: 'Audit the system',
		body: 'Review schema, scripts, layouts, security, integrations, server configuration, and performance risks before deciding what to fix.',
	},
	{
		title: 'Modernize the workflow',
		body: 'Clean up processes, reduce manual work, improve reliability, and make FileMaker easier for the team to trust and use.',
	},
	{
		title: 'Add AI carefully',
		body: 'Connect FileMaker to practical AI workflows for search, summaries, automation, analysis, and controlled data access.',
	},
];

const proofPoints = [
	{ label: '33 years FileMaker experience' },
	{ label: 'Former FileMaker platform product manager' },
	{ label: 'FileMaker infrastructure, AI, and product strategy experience' },
	{ label: 'Creator of FMDojo', href: 'https://fmdojo.com' },
];

const stories = [
	{
		title: 'Sterilization workflow and QR code labeling',
		body: 'Reviewed a barcode process, found duplicate and missing-code risks, and redesigned the flow around iPhones, on-demand Zebra printing, and better FileMaker records.',
	},
	{
		title: 'Overnight batch reduced to 30 minutes',
		body: 'Reworked a long-running FileMaker process into parallel scripts that processed and updated more than 70K parent records with dependent child data.',
	},
	{
		title: 'Live scoring systems where accuracy mattered',
		body: 'Built FileMaker systems for live projected math competition scoring and school registration workflows where the results had to be right in real time.',
	},
];
---

<PageLayout
	title={SITE_TITLE}
	description={SITE_DESCRIPTION}
	heroTitle="Expert FileMaker Consulting for Systems That Matter"
	heroSubtitle="ZeroBlue audits, modernizes, AI-enables, and stabilizes FileMaker systems without guessing what is broken."
	heroEyebrow="FileMaker experts since 1993"
>
	<Fragment slot="heroVisual">
		<div class="surface-card p-6">
			<div class="color-strip mb-5"></div>
			<div class="space-y-4">
				<a
					href="/blog/#latest-articles"
					class="group block rounded-xl bg-sky-100 p-4 transition hover:-translate-y-0.5 hover:bg-sky-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-500 dark:bg-sky-500/15 dark:hover:bg-sky-500/25"
				>
					<div class="flex items-center justify-between gap-4">
						<div class="text-sm font-semibold text-sky-700 dark:text-sky-200">Latest articles</div>
						<span class="text-sm font-semibold text-sky-600 transition group-hover:translate-x-1 dark:text-sky-200">→</span>
					</div>
					<p class="mt-2 text-sm text-slate-700 dark:text-slate-300">Read the newest FileMaker notes.</p>
				</a>
				<a
					href="/tag/developer/"
					class="group block rounded-xl bg-teal-100 p-4 transition hover:-translate-y-0.5 hover:bg-teal-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-500 dark:bg-teal-500/15 dark:hover:bg-teal-500/25"
				>
					<div class="flex items-center justify-between gap-4">
						<div class="text-sm font-semibold text-teal-700 dark:text-teal-200">Implementation details</div>
						<span class="text-sm font-semibold text-teal-600 transition group-hover:translate-x-1 dark:text-teal-200">→</span>
					</div>
					<p class="mt-2 text-sm text-slate-700 dark:text-slate-300">Browse developer-focused build notes.</p>
				</a>
				<a
					href="/portfolio/"
					class="group block rounded-xl bg-amber-100 p-4 transition hover:-translate-y-0.5 hover:bg-amber-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-500 dark:bg-amber-500/15 dark:hover:bg-amber-500/25"
				>
					<div class="flex items-center justify-between gap-4">
						<div class="text-sm font-semibold text-amber-800 dark:text-amber-200">Client lessons</div>
						<span class="text-sm font-semibold text-amber-700 transition group-hover:translate-x-1 dark:text-amber-200">→</span>
					</div>
					<p class="mt-2 text-sm text-slate-700 dark:text-slate-300">See what changed in real projects.</p>
				</a>
			</div>
		</div>
	</Fragment>

	<section class="py-12 lg:py-16">
		<div class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-stretch">
			<div class="surface-card p-8 lg:p-10">
				<p class="text-sm font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-300">Expert diagnosis, practical execution</p>
				<h2 class="mt-4 text-3xl font-bold tracking-tight text-slate-950 dark:text-white md:text-4xl">
					Bring the system that matters. Get a clear read on what is actually wrong.
				</h2>
				<p class="mt-5 text-lg leading-8 text-slate-700 dark:text-slate-300">
					ZeroBlue focuses on FileMaker systems that already carry business responsibility: production apps,
					older databases, unstable servers, AI-ready workflows, and architecture that needs expert judgment.
				</p>
				<div class="mt-8 flex flex-col gap-3 sm:flex-row">
					<a href={consultationUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
						Schedule a Consultation
					</a>
					<a href="/services" class="btn-secondary">
						View Services
					</a>
				</div>
			</div>

			<div class="surface-card overflow-hidden">
				<div class="color-strip"></div>
				<div class="p-8 lg:p-10">
					<p class="text-sm font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-300">Credibility</p>
					<h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-950 dark:text-white">FileMaker work with product, server, and business context.</h2>
					<div class="mt-6 grid gap-3">
						{proofPoints.map((point) => (
							<div class="rounded-xl border border-slate-200 bg-slate-50 p-4 font-semibold text-slate-800 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-200">
								{point.href ? (
									<a href={point.href} target="_blank" rel="noopener noreferrer" class="accent-link">
										{point.label}
									</a>
								) : (
									point.label
								)}
							</div>
						))}
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="py-12 lg:py-16">
		<div class="mx-auto max-w-3xl text-center">
			<p class="text-sm font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-300">How ZeroBlue helps</p>
			<h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white md:text-4xl">
				Consulting for FileMaker systems that need more than hourly help.
			</h2>
		</div>

		<div class="mt-10 grid gap-6 lg:grid-cols-3">
			{focusAreas.map((area, index) => (
				<article class="surface-card surface-card-hover p-7">
					<div class="mb-5 inline-flex h-11 w-11 items-center justify-center rounded-xl bg-sky-100 text-lg font-bold text-sky-700 dark:bg-sky-500/15 dark:text-sky-200">
						{index + 1}
					</div>
					<h3 class="text-2xl font-bold tracking-tight text-slate-950 dark:text-white">{area.title}</h3>
					<p class="mt-4 leading-7 text-slate-700 dark:text-slate-300">{area.body}</p>
				</article>
			))}
		</div>
	</section>

	<section class="py-12 lg:py-16">
		<div class="surface-card overflow-hidden">
			<div class="color-strip"></div>
			<div class="grid gap-8 p-8 lg:grid-cols-[0.8fr_1.2fr] lg:p-10">
				<div>
					<p class="text-sm font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-300">Real work, client names withheld</p>
					<h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white">Practical FileMaker outcomes.</h2>
					<p class="mt-5 leading-7 text-slate-700 dark:text-slate-300">
						The work is usually not glamorous at first. It is business process, risk, performance, correctness,
						server health, and the details that keep people from fighting the system every day.
					</p>
				</div>
				<div class="grid gap-4">
					{stories.map((story) => (
						<article class="rounded-xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-700 dark:bg-slate-900/70">
							<h3 class="font-bold text-slate-950 dark:text-white">{story.title}</h3>
							<p class="mt-2 leading-7 text-slate-700 dark:text-slate-300">{story.body}</p>
						</article>
					))}
				</div>
			</div>
		</div>
	</section>

	<section class="py-12 lg:py-16">
		<div class="grid gap-6 lg:grid-cols-2">
			<div class="surface-card p-8 lg:p-10">
				<p class="text-sm font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-300">FileMaker-specific AI</p>
				<h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white">
					Explore <a href="https://fmdojo.com" target="_blank" rel="noopener noreferrer" class="accent-link">FMDojo</a>.
				</h2>
				<p class="mt-5 leading-7 text-slate-700 dark:text-slate-300">
					FMDojo is the FileMaker-focused AI and monitoring ecosystem created from the same practical consulting experience.
				</p>
			</div>
			<div class="surface-card p-8 lg:p-10">
				<p class="text-sm font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-300">FileMaker hosting</p>
				<h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white">
					Need infrastructure? See <a href="https://radfm.cloud" target="_blank" rel="noopener noreferrer" class="accent-link">RadFM</a>.
				</h2>
				<p class="mt-5 leading-7 text-slate-700 dark:text-slate-300">
					RadFM handles FileMaker hosting while ZeroBlue focuses on consulting, system improvement, AI integration, and reliability.
				</p>
			</div>
		</div>
	</section>

	<section class="surface-card overflow-hidden p-8 lg:p-10">
		<div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
			<div>
				<p class="text-sm font-semibold uppercase tracking-wider text-sky-700 dark:text-sky-300">Start with the real problem</p>
				<h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white md:text-4xl">Need a FileMaker audit, AI plan, or server review?</h2>
				<p class="mt-4 max-w-3xl leading-7 text-slate-700 dark:text-slate-300">
					Bring the symptoms, goals, or system history. ZeroBlue can help decide what is worth fixing first.
				</p>
			</div>
			<a href={consultationUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-xl bg-sky-600 px-6 py-3 font-semibold text-white shadow-lg shadow-sky-900/15 transition hover:-translate-y-0.5 hover:bg-sky-700 dark:bg-sky-500 dark:text-slate-950 dark:hover:bg-sky-400">
				Schedule a Consultation
			</a>
		</div>
	</section>
</PageLayout>
