---
import BaseHead from '@/components/BaseHead.astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import BlogArchive from '@/components/BlogArchive.astro'
import { SITE_TITLE, SITE_DESCRIPTION, PAGE_SIZE } from '@/config.ts'
import { sortedPosts } from '@/js/util.js'

export async function getStaticPaths({ paginate }) {
  const postImportResult = import.meta.glob('../../posts/*.{md,mdx}', { eager: true })
  const posts = sortedPosts(Object.values(postImportResult))
  return paginate(posts, { pageSize: PAGE_SIZE })
}
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead title={`${SITE_TITLE} » Page ${Astro.props.page.currentPage}`} description={SITE_DESCRIPTION} />
  </head>
  <body class="site-body">
    <Header />
    <section class="hero-panel">
      <div class="hero-grid">
        <div>
          <div class="eyebrow">
            <span class="h-2 w-2 rounded-full bg-teal-400"></span>
            Blog archive
          </div>
          <h1 class="hero-title">FileMaker Development Blog</h1>
          <p class="hero-subtitle">
            Page {Astro.props.page.currentPage} of practical ZeroBlue articles, examples, and implementation notes.
          </p>
        </div>
        <div class="hidden lg:block">
          <div class="surface-card p-6">
            <div class="color-strip mb-5"></div>
            <div class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Archive page</div>
            <div class="mt-3 text-5xl font-bold text-slate-950 dark:text-white">{Astro.props.page.currentPage}</div>
            <div class="mt-5 grid grid-cols-3 gap-3">
              <div class="h-16 rounded-xl bg-sky-100 dark:bg-sky-500/15"></div>
              <div class="h-16 rounded-xl bg-teal-100 dark:bg-teal-500/15"></div>
              <div class="h-16 rounded-xl bg-amber-100 dark:bg-amber-500/15"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <main class="site-main pt-12">
      <BlogArchive posts={Astro.props.page.data} page={Astro.props.page} />
    </main>
    <Footer />
  </body>
</html>
