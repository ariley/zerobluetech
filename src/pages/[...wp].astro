---
import BaseHead from '../components/BaseHead.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { sortedPosts } from '@/js/util.js'

export async function getStaticPaths() {
  const postImportResult = import.meta.glob('../posts/*.{md,mdx}', { eager: true })
  const posts = sortedPosts(Object.values(postImportResult))
  // Filter out posts without permalinks (system pages)
  const postsWithPermalinks = posts.filter(post => post.frontmatter.permalink)
  return postsWithPermalinks.map((post, index) => {
    const nextPost = postsWithPermalinks[index - 1]?.frontmatter
    const previousPost = postsWithPermalinks[index + 1]?.frontmatter

    return {
      params: {
        // these `.slice` calls are necessary and remove
        // the `/` from the beginning and end of the permalink
        wp: post.frontmatter.permalink.slice(1).slice(0, -1)
      },
      props: {
        ...post,
        nextPost,
        previousPost,
      }
    }
  })
}

const { Content, frontmatter, nextPost, previousPost } = Astro.props
const { title, date, pubDate, categories } = frontmatter
const postDate = pubDate || date
const formattedDate = postDate && new Date(postDate).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })
const category = categories && categories.length > 0 ? categories[0] : null
const consultationUrl = 'https://calendly.com/agnesriley'
const postCtas = [
  {
    title: 'FileMaker System & App Audits',
    points: [
      'Review schema, scripts, layouts, security, integrations, and performance risks',
      'Deliver prioritized findings and recommendations',
    ],
  },
  {
    title: 'FileMaker AI Integration',
    points: [
      'Connect FileMaker to AI workflows',
      'Add AI-assisted search, summaries, data access, automation, and analysis',
    ],
  },
]
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead title={title} description={frontmatter.description || title} />
  </head>
  <body class="site-body">
    <Header />

      <main class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
        <div class="grid gap-8 lg:grid-cols-[minmax(0,2fr)_minmax(18rem,1fr)] lg:items-start">
          <article class="surface-card overflow-hidden p-8 sm:p-10">
            <nav aria-label="Breadcrumb" class="mb-6 flex flex-wrap items-center gap-2 text-sm font-medium text-slate-500 dark:text-slate-400">
              <a href="/blog/" class="text-sky-700 transition hover:text-teal-700 dark:text-sky-300 dark:hover:text-teal-200">Blog</a>
              <span aria-hidden="true">/</span>
              <span class="text-slate-700 dark:text-slate-300">{title}</span>
            </nav>

            <div class="color-strip mb-8"></div>
            <div class="flex items-center gap-3 mb-6">
              {category && (
                <span class="rounded-full bg-sky-100 px-3 py-1 text-sm font-semibold text-sky-700 dark:bg-sky-500/15 dark:text-sky-200">{category}</span>
              )}
              {formattedDate && (
                <>
                  <span class="text-slate-300 dark:text-slate-600">•</span>
                  <time datetime={postDate} class="text-sm text-slate-500 dark:text-slate-400">{formattedDate}</time>
                </>
              )}
            </div>

            <h1 class="text-4xl md:text-5xl font-bold mb-12 text-slate-950 dark:text-white tracking-tight">{title}</h1>

            <div class="prose prose-lg dark:prose-invert max-w-none prose-headings:text-slate-950 dark:prose-headings:text-white prose-a:text-sky-600 hover:prose-a:text-teal-600 dark:prose-a:text-sky-300 dark:hover:prose-a:text-teal-200 prose-code:text-sky-600 dark:prose-code:text-sky-300 prose-p:text-slate-700 dark:prose-p:text-slate-300 prose-p:leading-relaxed">
              <Content />
            </div>

            {(previousPost || nextPost) && (
              <nav aria-label="Post navigation" class="mt-12 grid gap-4 border-t border-slate-200 pt-8 dark:border-slate-800 sm:grid-cols-2">
                {previousPost ? (
                  <a href={previousPost.permalink} class="rounded-xl border border-slate-200 p-4 no-underline transition hover:border-sky-300 hover:bg-sky-50 dark:border-slate-700 dark:hover:border-sky-500 dark:hover:bg-slate-900">
                    <span class="block text-sm font-semibold text-slate-500 dark:text-slate-400">Previous post</span>
                    <span class="mt-1 block font-bold text-slate-950 dark:text-white">{previousPost.title}</span>
                  </a>
                ) : (
                  <span></span>
                )}

                {nextPost && (
                  <a href={nextPost.permalink} class="rounded-xl border border-slate-200 p-4 text-left no-underline transition hover:border-sky-300 hover:bg-sky-50 dark:border-slate-700 dark:hover:border-sky-500 dark:hover:bg-slate-900 sm:text-right">
                    <span class="block text-sm font-semibold text-slate-500 dark:text-slate-400">Next post</span>
                    <span class="mt-1 block font-bold text-slate-950 dark:text-white">{nextPost.title}</span>
                  </a>
                )}
              </nav>
            )}

          </article>

          <aside class="space-y-5 lg:sticky lg:top-6">
            {postCtas.map((cta) => (
              <section class="surface-card p-6">
                <div class="color-strip mb-5"></div>
                <h2 class="text-xl font-bold tracking-tight text-slate-950 dark:text-white">{cta.title}</h2>
                <ul class="mt-4 space-y-3">
                  {cta.points.map((point) => (
                    <li class="flex gap-3 text-sm leading-6 text-slate-700 dark:text-slate-300">
                      <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-teal-500"></span>
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
                <a href={consultationUrl} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex font-semibold text-sky-700 transition hover:text-teal-700 dark:text-sky-300 dark:hover:text-teal-200">
                  Schedule a Consultation
                </a>
              </section>
            ))}

            <section class="rounded-xl bg-slate-950 p-6 text-white shadow-lg dark:bg-sky-950">
              <p class="text-xs font-semibold uppercase tracking-wider text-teal-300">FileMaker-specific AI</p>
              <h2 class="mt-3 text-xl font-bold tracking-tight">Try FM Dojo for FileMaker development work.</h2>
              <p class="mt-4 text-sm leading-6 text-slate-300">
                FileMaker-aware AI chat, script help, SQL testing, schema analysis, AI data access, and practical developer workflows.
              </p>
              <a href="https://fmdojo.com" target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex items-center justify-center rounded-xl bg-sky-600 px-4 py-2.5 text-sm font-semibold text-white shadow-lg transition hover:-translate-y-0.5 hover:bg-sky-700">
                Visit FM Dojo
              </a>
            </section>
          </aside>
        </div>
      </main>
    <Footer />
  </body>
</html>
