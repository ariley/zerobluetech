---
export interface Props extends astroHTML.JSX.AnchorHTMLAttributes {}

const { href, class: className, ...props } = Astro.props;
const isActive = href === Astro.url.pathname.replace(/\/$/, '');
---

<a
	href={href}
	class:list={[
		'block rounded-lg px-0 py-2 font-medium text-slate-700 transition-colors hover:text-sky-600 dark:text-slate-300 dark:hover:text-sky-300 md:inline md:px-0 md:py-0',
		{ 'font-bold text-sky-700 dark:text-sky-200': isActive },
		className
	]}
	{...props}
>
	<slot />
</a>
