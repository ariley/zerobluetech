---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { SITE_DESCRIPTION, SITE_TITLE } from '../config';

export interface Props {
	title: string;
	description: string;
	image?: string;
}

const { title, description, image = '/placeholder-social.jpg' } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const socialImageUrl = new URL(image, Astro.site ?? Astro.url).toString();
const organizationId = 'https://zerobluetech.com/#organization';
const websiteId = 'https://zerobluetech.com/#website';
const pageId = `${canonicalUrl}#webpage`;
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'ProfessionalService',
			'@id': organizationId,
			name: 'ZeroBlue Technology Solutions',
			alternateName: 'ZeroBlue',
			url: 'https://zerobluetech.com/',
			logo: new URL('/favicon.svg', Astro.site ?? Astro.url).toString(),
			description: SITE_DESCRIPTION,
			areaServed: 'United States',
			serviceType: [
				'FileMaker consulting',
				'FileMaker system audits',
				'FileMaker AI integration',
				'FileMaker Server setup and optimization',
				'Modern web application development',
				'Business system modernization',
			],
			knowsAbout: [
				'Claris FileMaker',
				'FileMaker Server',
				'FileMaker AI integration',
				'Next.js',
				'Astro',
				'React',
				'Database-backed web applications',
				'Business process automation',
			],
		},
		{
			'@type': 'WebSite',
			'@id': websiteId,
			url: 'https://zerobluetech.com/',
			name: SITE_TITLE,
			description: SITE_DESCRIPTION,
			publisher: { '@id': organizationId },
			inLanguage: 'en-US',
		},
		{
			'@type': 'WebPage',
			'@id': pageId,
			url: canonicalUrl,
			name: title,
			description,
			isPartOf: { '@id': websiteId },
			about: { '@id': organizationId },
			inLanguage: 'en-US',
		},
	],
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={canonicalUrl} />
<meta name="generator" content={Astro.generator} />
<meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#020617" media="(prefers-color-scheme: dark)" />

<!-- Google Fonts - Preload to prevent flash -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Raleway:wght@300;400;500;600;700&display=block" rel="stylesheet">

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content="FileMaker consulting, FileMaker audit, FileMaker AI integration, FileMaker Server setup, FileMaker performance consulting, FMDojo monitoring, Next.js development, Astro development, React development, database-backed web applications" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="ZeroBlue" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageUrl} />
<meta property="og:locale" content="en_US" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={socialImageUrl} />

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

<!-- Dark Mode Flash Prevention - Must run before body renders -->
<script is:inline>
	// Check for dark mode preference and apply class immediately
	if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
		document.documentElement.classList.add('dark');
	} else {
		document.documentElement.classList.remove('dark');
	}
</script>

<style is:global>
	html {
		font-family: 'Inter', sans-serif;
		scroll-behavior: smooth;
	}

	h1, h2, h3, h4, h5, h6 {
		font-family: 'Raleway', sans-serif !important;
	}

	body {
		margin: 0;
	}
</style>
