---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { SITE_DESCRIPTION, SITE_TITLE } from '../config';

export interface Props {
	title: string;
	description: string;
	image?: string;
	robots?: string;
	type?: 'website' | 'article';
	publishedTime?: string | Date;
	modifiedTime?: string | Date;
	author?: string;
	tags?: string[];
	faqs?: Array<{ question: string; answer: string }>;
}

const {
	title,
	description,
	image = '/og-home.png',
	robots = 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1',
	type = 'website',
	publishedTime,
	modifiedTime,
	author,
	tags = [],
	faqs = [],
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const socialImageUrl = new URL(image, Astro.site ?? Astro.url).toString();
const organizationId = 'https://zerobluetech.com/#organization';
const websiteId = 'https://zerobluetech.com/#website';
const pageId = `${canonicalUrl}#webpage`;
const publishedIso = publishedTime ? new Date(publishedTime).toISOString() : undefined;
const modifiedIso = modifiedTime ? new Date(modifiedTime).toISOString() : publishedIso;
const uniqueTags = Array.from(new Set(tags.filter(Boolean)));
const pageSchema = type === 'article'
	? {
			'@type': 'BlogPosting',
			'@id': pageId,
			mainEntityOfPage: { '@id': pageId },
			url: canonicalUrl,
			headline: title,
			name: title,
			description,
			image: socialImageUrl,
			datePublished: publishedIso,
			dateModified: modifiedIso,
			author: {
				'@type': 'Person',
				name: author || 'Agnes Riley',
			},
			publisher: { '@id': organizationId },
			isPartOf: { '@id': websiteId },
			keywords: uniqueTags,
			inLanguage: 'en-US',
		}
	: {
			'@type': 'WebPage',
			'@id': pageId,
			url: canonicalUrl,
			name: title,
			description,
			isPartOf: { '@id': websiteId },
			about: { '@id': organizationId },
			inLanguage: 'en-US',
		};
const founderId = 'https://zerobluetech.com/#founder';
const faqSchema = faqs.length > 0
	? {
			'@type': 'FAQPage',
			'@id': `${canonicalUrl}#faq`,
			mainEntity: faqs.map((faq) => ({
				'@type': 'Question',
				name: faq.question,
				acceptedAnswer: {
					'@type': 'Answer',
					text: faq.answer,
				},
			})),
		}
	: null;
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'ProfessionalService',
			'@id': organizationId,
			name: 'ZeroBlue Technology Solutions',
			alternateName: 'ZeroBlue',
			url: 'https://zerobluetech.com/',
			logo: new URL('/favicon.svg', Astro.site ?? Astro.url).toString(),
			description: SITE_DESCRIPTION,
			areaServed: 'United States',
			founder: { '@id': founderId },
			serviceType: [
				'FileMaker consulting',
				'FileMaker system audits',
				'FileMaker AI integration',
				'FileMaker Server setup and optimization',
				'Modern web application development',
				'Business system modernization',
			],
			knowsAbout: [
				'Claris FileMaker',
				'FileMaker Server',
				'FileMaker AI integration',
				'Next.js',
				'Astro',
				'React',
				'Database-backed web applications',
				'Business process automation',
			],
		},
		{
			'@type': 'Person',
			'@id': founderId,
			name: 'Agnes Riley',
			jobTitle: 'Founder, FileMaker Consultant',
			worksFor: { '@id': organizationId },
			description: 'FileMaker expert with 33 years of experience. Former FileMaker platform product manager. Creator of FMDojo.',
			knowsAbout: [
				'Claris FileMaker',
				'FileMaker Server',
				'FileMaker AI integration',
				'Database architecture',
				'Business process automation',
				'FileMaker performance and stability',
			],
		},
		{
			'@type': 'WebSite',
			'@id': websiteId,
			url: 'https://zerobluetech.com/',
			name: SITE_TITLE,
			description: SITE_DESCRIPTION,
			publisher: { '@id': organizationId },
			inLanguage: 'en-US',
		},
		pageSchema,
		...(faqSchema ? [faqSchema] : []),
	],
};
---

<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18185277748"></script>
<script is:inline>
	window.dataLayer = window.dataLayer || [];
	function gtag(){dataLayer.push(arguments);}
	gtag('js', new Date());

	gtag('config', 'AW-18185277748');
</script>
<script is:inline>
function gtag_report_conversion(url) {
  var callback = function () {
    if (typeof(url) != 'undefined') {
      window.location = url;
    }
  };
  gtag('event', 'conversion', {
    'send_to': 'AW-18185277748/ifTACOfd27kcELSitd9D',
    'event_callback': callback
  });
  return false;
}
</script>

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="canonical" href={canonicalUrl} />
<meta name="generator" content={Astro.generator} />
<meta name="robots" content={robots} />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#1e293b" media="(prefers-color-scheme: dark)" />

<!-- Google Fonts - Preload to prevent flash -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Raleway:wght@300;400;500;600;700&display=block" rel="stylesheet">

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content="FileMaker consulting, FileMaker audit, FileMaker AI integration, FileMaker Server setup, FileMaker performance consulting, FMDojo monitoring, Next.js development, Astro development, React development, database-backed web applications" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content="ZeroBlue" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="ZeroBlue expert FileMaker consulting" />
<meta property="og:locale" content="en_US" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={socialImageUrl} />

{type === 'article' && publishedIso && <meta property="article:published_time" content={publishedIso} />}
{type === 'article' && modifiedIso && <meta property="article:modified_time" content={modifiedIso} />}
{type === 'article' && author && <meta property="article:author" content={author} />}
{type === 'article' && uniqueTags.map((tag) => <meta property="article:tag" content={tag} />)}

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

<!-- Dark Mode Flash Prevention - Must run before body renders -->
<script is:inline>
	// Check for dark mode preference and apply class immediately
	if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
		document.documentElement.classList.add('dark');
	} else {
		document.documentElement.classList.remove('dark');
	}
</script>

<style is:global>
	html {
		font-family: 'Inter', sans-serif;
		scroll-behavior: smooth;
	}

	h1, h2, h3, h4, h5, h6 {
		font-family: 'Raleway', sans-serif !important;
		font-kerning: normal;
		font-feature-settings: "kern" 1, "liga" 1;
	}

	body {
		margin: 0;
	}
</style>
