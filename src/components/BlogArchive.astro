---
import WPArticleSummary from './WPArticleSummary.astro';
import { sortedPosts, urlifyToken } from '@/js/util.js';

const { posts, page } = Astro.props;
const currentPage = page?.currentPage ?? 1;
const prevUrl = currentPage === 2 ? '/blog/' : page?.url?.prev;
const nextUrl = page?.url?.next;
const hasMorePosts = Boolean(nextUrl || Astro.props.hasMorePosts);
const postImportResult = import.meta.glob('../posts/*.{md,mdx}', { eager: true });
const allPosts = sortedPosts(Object.values(postImportResult));
const tagCounts = allPosts.reduce((counts: Map<string, number>, post: any) => {
  post.frontmatter.tags?.forEach((tag: string) => {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  });
  return counts;
}, new Map());
const tagCloud = Array.from(tagCounts.entries())
  .map(([tag, count]) => ({ tag, count, href: `/tag/${urlifyToken(tag)}/` }))
  .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag));
---

<div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_18rem]">
  <section class="space-y-6" aria-label={`Blog posts page ${currentPage}`}>
    {posts.map((post: any) => (
      <WPArticleSummary page={post} maxWords={50} />
    ))}

    <nav class="mt-10 flex flex-col gap-3 border-t border-slate-200 pt-8 dark:border-slate-700 sm:flex-row sm:items-center sm:justify-between" aria-label="Post navigation">
      <div>
        {prevUrl && (
          <a href={prevUrl} class="btn-secondary">
            <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"></path>
            </svg>
            Newer Posts
          </a>
        )}
      </div>
      <div class="text-sm font-medium text-slate-500 dark:text-slate-400">Page {currentPage}</div>
      <div class="sm:text-right">
        {hasMorePosts && (
          <a href={nextUrl ?? '/page/2/'} class="btn-primary">
            Older Posts
            <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        )}
      </div>
    </nav>
  </section>

  <aside class="space-y-5">
    <div class="surface-card p-6">
      <div class="color-strip mb-5"></div>
      <h2 class="text-lg font-bold text-slate-950 dark:text-white">ZeroBlue Notes</h2>
      <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">
        Practical FileMaker, automation, and web development writing from real client work.
      </p>
    </div>
    <div class="surface-card p-6">
      <h2 class="text-lg font-bold text-slate-950 dark:text-white">Blog Cloud</h2>
      <div class="mt-4 flex flex-wrap gap-2">
        {tagCloud.map(({ tag, count, href }) => (
          <a
            href={href}
            class:list={[
              'rounded-full px-3 py-1 font-semibold transition',
              count >= 30 && 'bg-sky-100 text-base text-sky-700 hover:bg-sky-200 dark:bg-sky-500/15 dark:text-sky-200',
              count >= 10 && count < 30 && 'bg-teal-100 text-sm text-teal-700 hover:bg-teal-200 dark:bg-teal-500/15 dark:text-teal-200',
              count < 10 && 'bg-amber-100 text-xs text-amber-800 hover:bg-amber-200 dark:bg-amber-500/15 dark:text-amber-200'
            ]}
            aria-label={`${tag}: ${count} posts`}
          >
            {tag}
          </a>
        ))}
      </div>
    </div>
    <div class="surface-card overflow-hidden">
      <div class="color-strip"></div>
      <div class="space-y-4 p-6">
        <h2 class="text-lg font-bold text-slate-950 dark:text-white">Useful Tools</h2>
        <a
          href="https://fmdojo.com"
          target="_blank"
          rel="noopener noreferrer"
          class="group block rounded-xl border border-sky-200 bg-sky-50 p-4 transition hover:-translate-y-0.5 hover:border-sky-300 hover:bg-sky-100 dark:border-sky-400/20 dark:bg-sky-500/10 dark:hover:border-sky-300/50"
        >
          <div class="flex items-center justify-between gap-3">
            <h3 class="font-bold text-sky-800 dark:text-sky-100">FMDojo</h3>
            <svg class="h-4 w-4 text-sky-600 transition group-hover:translate-x-0.5 dark:text-sky-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7m0 0H8m9 0v9"></path>
            </svg>
          </div>
          <p class="mt-2 text-sm leading-5 text-sky-800/80 dark:text-sky-100/75">
            FileMaker learning, AI tools, scripts, snapshots, and developer workflows.
          </p>
        </a>
        <a
          href="https://radfm.cloud"
          target="_blank"
          rel="noopener noreferrer"
          class="group block rounded-xl border border-teal-200 bg-teal-50 p-4 transition hover:-translate-y-0.5 hover:border-teal-300 hover:bg-teal-100 dark:border-teal-400/20 dark:bg-teal-500/10 dark:hover:border-teal-300/50"
        >
          <div class="flex items-center justify-between gap-3">
            <h3 class="font-bold text-teal-800 dark:text-teal-100">RadFM Hosting</h3>
            <svg class="h-4 w-4 text-teal-600 transition group-hover:translate-x-0.5 dark:text-teal-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7m0 0H8m9 0v9"></path>
            </svg>
          </div>
          <p class="mt-2 text-sm leading-5 text-teal-800/80 dark:text-teal-100/75">
            Managed FileMaker hosting when your solution needs reliable infrastructure.
          </p>
        </a>
      </div>
    </div>
    <div class="surface-card p-6">
      <h2 class="text-lg font-bold text-slate-950 dark:text-white">Explore</h2>
      <div class="mt-4 flex flex-wrap gap-2">
        <a href="/blog/" class="rounded-full bg-sky-100 px-3 py-1 text-sm font-semibold text-sky-700 transition hover:bg-sky-200 dark:bg-sky-500/15 dark:text-sky-200">FileMaker</a>
        <a href="/services" class="rounded-full bg-teal-100 px-3 py-1 text-sm font-semibold text-teal-700 transition hover:bg-teal-200 dark:bg-teal-500/15 dark:text-teal-200">Services</a>
        <a href="/contact" class="rounded-full bg-amber-100 px-3 py-1 text-sm font-semibold text-amber-800 transition hover:bg-amber-200 dark:bg-amber-500/15 dark:text-amber-200">Start a project</a>
      </div>
    </div>
  </aside>
</div>
