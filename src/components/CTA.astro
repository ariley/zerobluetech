---
interface Props {
	title: string;
	description: string;
	buttonText: string;
	buttonHref: string;
}

const { title, description, buttonText, buttonHref } = Astro.props;
---

<section class="bg-gradient-to-r from-sky-400 via-blue-400 to-sky-400 dark:from-sky-500 dark:via-blue-500 dark:to-sky-500 rounded-lg shadow-xl p-12 text-center">
	<h2 class="text-3xl font-bold mb-4 text-white">{title}</h2>
	<p class="text-xl mb-8 text-white/90">{description}</p>
	<a
		href={buttonHref}
		class="inline-block rounded-lg bg-sky-700 px-8 py-3 font-semibold text-white transition-all duration-300 hover:scale-105 hover:bg-sky-800 hover:shadow-lg"
	>
		{buttonText}
	</a>
</section>
